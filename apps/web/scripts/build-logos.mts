/**
 * Writes the logos the site imports, from src/lib/logo-sources.ts, keeping only each icon's slug
 * and SVG path (simple-icons ships the full metadata of every icon):
 *   - src/lib/tech-icon-paths.ts: agents, languages and package managers (TechIcon, on every page)
 *   - src/lib/logo-paths.ts: libraries, frameworks and tags (TechLogo, kit and stack pages)
 *
 *   pnpm --filter web logos:build
 */
import { writeFileSync } from "node:fs";

import type { SimpleIcon } from "simple-icons";

import { LOGOS, TECH_ICONS } from "../src/lib/logo-sources";

function write(file: string, map: Record<string, SimpleIcon>, names: { paths: string; keys: string; what: string }) {
  const paths = new Map<string, string>();
  const keys = Object.fromEntries(
    Object.entries(map).map(([key, icon]) => {
      paths.set(icon.slug, icon.path);
      return [key, icon.slug];
    }),
  );
  writeFileSync(
    new URL(`../src/lib/${file}`, import.meta.url),
    `// Generated by scripts/build-logos.mts from src/lib/logo-sources.ts. Don't edit: run pnpm --filter web logos:build.
// Simple Icons (CC0): https://simpleicons.org

/** Simple Icons slug → SVG path (24×24). */
export const ${names.paths}: Record<string, string> = ${JSON.stringify(Object.fromEntries([...paths].sort(([a], [b]) => a.localeCompare(b))), null, 2)};

/** ${names.what} → slug. */
export const ${names.keys}: Record<string, string> = ${JSON.stringify(keys, null, 2)};
`,
  );
  console.log(`✓ ${file}: ${paths.size} logos, ${Object.keys(keys).length} keys`);
}

write("tech-icon-paths.ts", TECH_ICONS, { paths: "TECH_PATHS", keys: "TECH_ICON_KEYS", what: "Agent, language and package manager id" });
write("logo-paths.ts", LOGOS, { paths: "LOGO_PATHS", keys: "LOGO_KEYS", what: "Library, framework and tag key" });
