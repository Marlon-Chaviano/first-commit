# Copy to .env.local. Everything is optional: without these the site works and counters show 0.

# Redis (Upstash in production; SRH from docker-compose locally)
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=local_token

# Postgres (Neon / Supabase in production)
DATABASE_URL=postgres://kits:kits@localhost:5433/kits

# Manual runs of /api/cron/flush-events: Authorization: Bearer <CRON_SECRET>. min 16 chars.
CRON_SECRET=local-cron-secret-change-me

# QStash triggers scheduled jobs (free tier). Production: signing keys from the Upstash console.
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Only for `pnpm --filter web qstash:schedule` (creates/updates the schedule).
QSTASH_TOKEN=
# Local: run `npx @upstash/qstash-cli dev` and set this to use its fixed keys.
QSTASH_DEV=1

# Accounts (Better Auth). Secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3200
# GitHub OAuth app (phase 8). Callback: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google OAuth client (phase 8). Callback: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated handles with the admin role
ADMIN_HANDLES=dev
# Email + password login for local development only (ignored in production)
DEV_LOGIN=1
# Optional: xAI Grok for "Describe your project" (without it, the keyword recommender answers for free)
XAI_API_KEY=
# RECOMMEND_MODEL=grok-4.20-non-reasoning
# Sender for every email (default: Resend's test sender)
# EMAIL_FROM="kits <hola@tu-dominio>"
# Stripe (phase 7). Without STRIPE_SECRET_KEY billing and premium kits are off.
# Local tests: docker compose up -d stripe-mock, STRIPE_SECRET_KEY=sk_test_123, STRIPE_API_URL=http://localhost:12111
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
# STRIPE_API_URL=http://localhost:12111
# PLATFORM_FEE_PERCENT=15
# Optional: Google Search Console's HTML-tag verification (the domain is verified by DNS already).
# GOOGLE_SITE_VERIFICATION=
