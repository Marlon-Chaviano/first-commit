{
  "name": "create-first-commit",
  "version": "0.1.1",
  "description": "Install ready-to-code workspace kits: project template, dependencies, agent skills and MCP servers in one command.",
  "type": "module",
  "bin": {
    "create-first-commit": "./dist/index.js",
    "first-commit": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "first-commit",
    "create",
    "workspace",
    "kits",
    "skills",
    "agents",
    "claude-code",
    "cursor",
    "codex",
    "template",
    "scaffold"
  ],
  "license": "MIT",
  "homepage": "https://first-commit.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Marlon-Chaviano/first-commit.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "giget": "^3.3.1",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@kits/mcp": "workspace:*",
    "@kits/schema": "workspace:*",
    "@modelcontextprotocol/server": "2.4.0",
    "@types/node": "^24.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  }
}
