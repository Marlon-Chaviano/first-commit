{
  "$schema": "../../kit.schema.json",
  "name": "landing-next",
  "version": "1.3.1",
  "title": "Landing page with Next.js",
  "description": "Next.js + Tailwind with design skills, React best practices and deployment on Vercel. For landing pages that don't look AI-made.",
  "category": "landing",
  "tags": [
    "nextjs",
    "tailwind",
    "design",
    "vercel"
  ],
  "author": "Marlon Chaviano",
  "base": {
    "command": "npx create-next-app@latest {{name}} --ts --tailwind --eslint --app --src-dir --import-alias \"@/*\" --use-{{pm}} --disable-git --no-agent-feedback --yes"
  },
  "verify": {
    "command": "{{pm}} run build",
    "matrix": [
      {
        "component-addons": [
          "kokonutui",
          "magicui"
        ],
        "animation": [
          "motion",
          "gsap"
        ],
        "observability": [
          "sentry-nextjs",
          "posthog-nextjs"
        ]
      },
      {
        "i18n": [
          "next-intl"
        ],
        "testing": [
          "vitest"
        ],
        "quality": [
          "husky-lint-staged"
        ],
        "ci": [
          "github-actions"
        ],
        "deploy": [
          "vercel"
        ],
        "animation": [
          "motion"
        ]
      }
    ]
  },
  "skills": [
    "vercel-labs/agent-skills@vercel-react-best-practices",
    "vercel-labs/agent-skills@deploy-to-vercel"
  ],
  "options": [
    {
      "id": "extras",
      "label": "Extras",
      "type": "multi",
      "default": [],
      "choices": [
        {
          "id": "seo",
          "label": "SEO and Open Graph",
          "instructions": "## SEO\n\nEvery page exports `metadata` (title, description, Open Graph). Generate `src/app/sitemap.ts`, `src/app/robots.ts` and an OG image with `opengraph-image.tsx`."
        }
      ]
    }
  ],
  "libraries": {
    "framework": [
      "react",
      "nextjs"
    ],
    "components": "shadcn",
    "addons": [],
    "animation": [
      "motion"
    ],
    "observability": [
      "vercel-analytics"
    ],
    "i18n": "none",
    "testing": [],
    "quality": [],
    "ci": [],
    "deploy": "vercel",
    "design": [
      "design-pack"
    ],
    "workflow": [
      "essentials"
    ],
    "forms": []
  },
  "instructions": "## How to work here\n\n- Landing sections as components in `src/components/sections/`.\n- Before writing UI, read the `frontend-design` skill and set a visual direction (typography, color, rhythm).\n- Review the result with `web-design-guidelines` before calling anything done.",
  "language": "typescript"
}
