{
  "$schema": "../../kit.schema.json",
  "name": "monorepo-turbo",
  "version": "2.0.0",
  "author": "marlon-chaviano",
  "title": "Monorepo with Turborepo",
  "description": "One repo for your whole product: pick the web app (Next.js or Vite), and optionally a mobile app with Expo, an API with Hono and docs with Starlight. Shared UI and config packages, and cached builds with Turborepo.",
  "category": "monorepo",
  "language": "typescript",
  "tags": [
    "monorepo",
    "turborepo",
    "nextjs",
    "expo",
    "hono",
    "typescript"
  ],
  "base": {
    "command": "echo 'This workspace needs CLI version 1.1.0 or newer. Update the CLI and try again.' >&2; exit 1"
  },
  "packageManagers": [
    "pnpm",
    "npm",
    "bun"
  ],
  "workspace": {
    "services": {
      "web": {
        "label": "Web",
        "path": "apps/web",
        "default": "nextjs",
        "variants": {
          "nextjs": "web-next@1.0.4",
          "react": "spa-vite-react@1.2.4",
          "vue": "web-vue-vite@1.1.4",
          "nuxt": "web-nuxt@1.2.4",
          "sveltekit": "web-sveltekit@1.2.4",
          "astro": "web-astro@1.2.4",
          "angular": "web-angular@1.1.4",
          "react-router": "web-react-router@1.1.4",
          "tanstack-start": "web-tanstack-start@1.1.4"
        }
      },
      "api": {
        "label": "Api",
        "path": "apps/api",
        "default": "hono",
        "variants": {
          "django": "api-django@1.2.4",
          "fastapi": "api-fastapi@1.3.4",
          "hono": "api-hono@1.4.4",
          "express": "api-express@1.0.4",
          "fastify": "api-fastify@1.1.4",
          "nestjs": "api-nestjs@1.1.4",
          "elysia": "api-elysia@1.2.4",
          "go": "api-go@1.3.4",
          "rails": "api-rails@1.1.4",
          "spring": "api-spring-boot@1.2.4",
          "laravel": "api-laravel@1.1.4",
          "aspnet": "api-aspnet@1.0.4",
          "axum": "api-axum@1.0.4"
        }
      },
      "docs": {
        "label": "Docs",
        "path": "apps/docs",
        "default": "none",
        "variants": {
          "starlight": "docs-starlight@1.1.4",
          "vitepress": "docs-vitepress@1.1.4",
          "fumadocs": "docs-fumadocs@1.1.4"
        }
      },
      "mobile": {
        "label": "Mobile",
        "path": "apps/mobile",
        "default": "none",
        "variants": {
          "expo": "mobile-expo@1.4.4"
        }
      }
    },
    "orchestrator": "turbo",
    "migrations": {
      "web": {
        "choices": {
          "next": {
            "web": [
              "nextjs"
            ]
          },
          "vite": {
            "web": [
              "react"
            ]
          }
        }
      },
      "apps": {
        "defaults": {
          "api": [
            "none"
          ],
          "docs": [
            "none"
          ],
          "mobile": [
            "none"
          ]
        },
        "choices": {
          "api": {
            "api": [
              "hono"
            ]
          },
          "mobile": {
            "mobile": [
              "expo"
            ]
          },
          "docs": {
            "docs": [
              "starlight"
            ]
          }
        }
      }
    }
  },
  "libraries": {
    "framework": "monorepo",
    "workflow": [
      "essentials"
    ],
    "security": [
      "security-pack"
    ]
  },
  "options": [
    {
      "id": "deployment",
      "label": "Deployment mode",
      "default": "none",
      "choices": [
        {
          "id": "none",
          "label": "Configure later"
        },
        {
          "id": "independent",
          "label": "Independent services"
        },
        {
          "id": "compose",
          "label": "Docker Compose"
        }
      ]
    },
    {
      "id": "orchestrator",
      "label": "Workspace tasks",
      "default": "turbo",
      "choices": [
        {
          "id": "simple",
          "label": "Simple scripts"
        },
        {
          "id": "turbo",
          "label": "Turborepo"
        },
        {
          "id": "nx",
          "label": "Nx"
        }
      ]
    }
  ],
  "verify": {
    "command": "node scripts/workspace.mjs verify",
    "matrix": []
  },
  "minCliVersion": "1.1.0"
}
