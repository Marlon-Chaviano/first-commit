{
  "$schema": "../../kit.schema.json",
  "version": "1.1.3",
  "author": "marlon-chaviano",
  "name": "mobile-kmp",
  "title": "App with Kotlin Multiplatform",
  "category": "mobile",
  "language": "kotlin",
  "description": "JetBrains' official template: Kotlin Multiplatform with Compose Multiplatform to share logic and UI between Android and iOS.",
  "tags": [
    "kotlin",
    "kotlin-multiplatform",
    "compose-multiplatform",
    "android",
    "ios"
  ],
  "base": {
    "command": "npx -y tiged Kotlin/KMP-App-Template {{name}}"
  },
  "packageManagers": [
    "gradle"
  ],
  "skills": [
    "affaan-m/ecc@kotlin-patterns",
    "affaan-m/ecc@kotlin-coroutines-flows",
    "affaan-m/ecc@kotlin-testing",
    "android/skills@adaptive",
    "android/skills@jetpack-compose-performance"
  ],
  "libraries": {
    "framework": [
      "android"
    ],
    "design": [
      "design-pack-native"
    ],
    "workflow": [
      "essentials"
    ],
    "security": [
      "security-pack"
    ],
    "auth": "none",
    "ci": [],
    "data": "none",
    "deploy": "none",
    "forms": [],
    "quality": [],
    "testing": [],
    "database": "none",
    "i18n": "none",
    "state": "none"
  },
  "verify": {
    "command": "./gradlew --no-daemon :androidApp:assembleDebug",
    "matrix": [
      {
        "state": [
          "kotlin-stateflow"
        ],
        "data": [
          "ktor-client"
        ],
        "forms": [
          "kotlinx-serialization"
        ],
        "auth": [
          "android-credentials"
        ],
        "database": [
          "room"
        ],
        "i18n": [
          "android-localization"
        ],
        "testing": [
          "android-unit-tests"
        ],
        "quality": [
          "android-lint"
        ],
        "ci": [
          "github-actions-android"
        ],
        "deploy": [
          "android-stores"
        ]
      }
    ]
  },
  "setupTasks": [
    "KMP: open the project in Android Studio or IntelliJ with the Kotlin Multiplatform plugin; for iOS you need Xcode on macOS."
  ],
  "instructions": "## How to work here\n\n- Shared code lives in `composeApp/src/commonMain/` (logic and UI with Compose Multiplatform); platform-specific code in `androidMain/` and `iosMain/` through `expect`/`actual`.\n- Prefer multiplatform libraries (Ktor, Koin, kotlinx) over single-platform ones.\n- Before finishing: `./gradlew :androidApp:assembleDebug`."
}
