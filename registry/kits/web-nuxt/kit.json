{
  "$schema": "../../kit.schema.json",
  "name": "web-nuxt",
  "version": "1.2.1",
  "author": "marlon-chaviano",
  "title": "Web app with Nuxt",
  "category": "web",
  "language": "typescript",
  "description": "Nuxt with Vue 3 and TypeScript: server rendering, file-based routes and auto-imports.",
  "tags": [
    "nuxt",
    "vue",
    "ssr",
    "typescript"
  ],
  "base": {
    "command": "npx nuxi@latest init {{name}} --template minimal --packageManager {{pm}} --gitInit=false --no-install --force",
    "install": "{{pm}} install"
  },
  "skills": [
    "onmax/nuxt-skills@nuxt",
    "antfu/skills@nuxt",
    "vuejs-ai/skills@vue-best-practices",
    "vuejs-ai/skills@vue-router-best-practices",
    "vuejs-ai/skills@vue-pinia-best-practices",
    "vuejs-ai/skills@vue-testing-best-practices",
    "vuejs-ai/skills@vue-debug-guides",
    "vuejs-ai/skills@create-adaptable-composable",
    "antfu/skills@vue",
    "wshobson/agents@typescript-advanced-types"
  ],
  "verify": {
    "command": "{{pm}} run build",
    "matrix": [
      {
        "styling-lib": [
          "tailwind-nuxt"
        ],
        "state": [
          "pinia"
        ],
        "data": [
          "tanstack-query-vue"
        ],
        "forms": [
          "zod"
        ]
      }
    ]
  },
  "libraries": {
    "framework": [
      "vue",
      "nuxt"
    ],
    "components": "none",
    "animation": [],
    "design": [
      "design-pack"
    ],
    "workflow": [
      "essentials"
    ],
    "styling": "none",
    "state": "none",
    "data": "none",
    "forms": []
  },
  "instructions": "## How to work here\n\n- Pages in `app/pages/`, components in `app/components/` (auto-imported) and reusable logic in `app/composables/`.\n- Data with `useFetch` / `useAsyncData`, not with `fetch` inside `onMounted`.\n- Your own API in `server/api/`.\n- Before finishing: `npm run build`."
}
