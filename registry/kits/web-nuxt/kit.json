{
  "$schema": "../../kit.schema.json",
  "name": "web-nuxt",
  "version": "1.2.4",
  "author": "marlon-chaviano",
  "title": "Web app with Nuxt",
  "category": "web",
  "language": "typescript",
  "description": "Nuxt with Vue 3 and TypeScript: server rendering, file-based routes and auto-imports.",
  "tags": [
    "nuxt",
    "vue",
    "ssr",
    "typescript"
  ],
  "base": {
    "command": "npx nuxi@latest init {{name}} --template minimal --packageManager {{pm}} --gitInit=false --no-install --force",
    "install": "{{pm}} install"
  },
  "skills": [
    "onmax/nuxt-skills@nuxt",
    "antfu/skills@nuxt",
    "vuejs-ai/skills@vue-best-practices",
    "vuejs-ai/skills@vue-router-best-practices",
    "vuejs-ai/skills@vue-pinia-best-practices",
    "vuejs-ai/skills@vue-testing-best-practices",
    "vuejs-ai/skills@vue-debug-guides",
    "vuejs-ai/skills@create-adaptable-composable",
    "antfu/skills@vue",
    "wshobson/agents@typescript-advanced-types"
  ],
  "verify": {
    "command": "{{pm}} run build",
    "matrix": [
      {
        "styling-lib": [
          "tailwind-nuxt"
        ],
        "state": [
          "pinia"
        ],
        "data": [
          "tanstack-query-vue"
        ],
        "forms": [
          "zod"
        ]
      },
      {
        "components": [
          "nuxt-ui"
        ],
        "forms": [
          "valibot",
          "vee-validate"
        ],
        "auth": [
          "nuxt-auth-utils"
        ],
        "database": [
          "drizzle-nuxt"
        ],
        "payments": [
          "stripe-server"
        ],
        "email": [
          "resend-nuxt"
        ],
        "i18n": [
          "nuxt-i18n"
        ],
        "ai": [
          "openai-sdk"
        ],
        "observability": [
          "sentry-nuxt"
        ],
        "testing": [
          "vitest-vue"
        ],
        "quality": [
          "prettier"
        ],
        "deploy": [
          "netlify-nuxt"
        ]
      },
      {
        "auth": [
          "supabase-js"
        ],
        "deploy": [
          "docker-nuxt"
        ]
      },
      {
        "auth": [
          "better-auth-server"
        ],
        "deploy": [
          "railway-nuxt"
        ]
      }
    ]
  },
  "libraries": {
    "framework": [
      "vue",
      "nuxt"
    ],
    "components": "none",
    "animation": [],
    "design": [
      "design-pack"
    ],
    "workflow": [
      "essentials"
    ],
    "styling": "none",
    "state": "none",
    "data": "none",
    "forms": [],
    "security": [
      "security-pack"
    ],
    "ai": [],
    "auth": "none",
    "ci": [],
    "database": "none",
    "deploy": "none",
    "email": "none",
    "i18n": "none",
    "observability": [],
    "payments": "none",
    "quality": [],
    "testing": []
  },
  "instructions": "## How to work here\n\n- Pages in `app/pages/`, components in `app/components/` (auto-imported) and reusable logic in `app/composables/`.\n- Data with `useFetch` / `useAsyncData`, not with `fetch` inside `onMounted`.\n- Your own API in `server/api/`.\n- Before finishing: `npm run build`.",
  "service": {
    "dev": "{{pm}} run dev",
    "build": "{{pm}} run build",
    "start": "node .output/server/index.mjs",
    "port": 3000,
    "install": "npm install",
    "ci": [],
    "dockerfile": "FROM node:22-slim\nWORKDIR /app\nRUN npm install -g pnpm bun serve\nCOPY {{servicePath}}/ .\nRUN {{pm}} install\nRUN {{pm}} run build\nENV NODE_ENV=production\nENV PORT=3000\nEXPOSE 3000\nCMD [\"sh\", \"-c\", \"node .output/server/index.mjs\"]\n",
    "client": {
      "env": "NUXT_PUBLIC_API_URL",
      "files": [
        {
          "path": "api-client.js",
          "mode": "create",
          "content": "import { useRuntimeConfig } from '#imports';\nexport async function apiHealth(baseUrl = useRuntimeConfig().public.apiUrl || '{{apiUrl}}') {\n  const response = await fetch(baseUrl + '{{healthPath}}');\n  if (!response.ok) throw new Error('API health check failed: ' + response.status);\n  return response.headers.get('content-type')?.includes('json') ? response.json() : { ok: true };\n}\n"
        },
        {
          "path": "nuxt.config.ts",
          "mode": "replace",
          "anchor": "export default defineNuxtConfig({",
          "content": "export default defineNuxtConfig({\n  runtimeConfig: { public: { apiUrl: '{{apiUrl}}' } },"
        }
      ]
    }
  }
}
