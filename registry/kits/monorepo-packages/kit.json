{
  "$schema": "../../kit.schema.json",
  "version": "2.1.0",
  "author": "marlon-chaviano",
  "name": "monorepo-packages",
  "title": "npm libraries monorepo",
  "category": "monorepo",
  "language": "typescript",
  "description": "To publish several npm libraries from one repo: pnpm workspaces, builds with tsup (ESM + types), tests with Vitest, and versions and changelogs with Changesets.",
  "tags": [
    "npm",
    "library",
    "pnpm",
    "tsup",
    "changesets",
    "vitest"
  ],
  "base": {
    "command": "echo 'This workspace needs CLI version 1.1.0 or newer. Update the CLI and try again.' >&2; exit 1"
  },
  "packageManagers": [
    "pnpm"
  ],
  "finalize": [
    "pnpm install"
  ],
  "writeFiles": [
    {
      "path": "package.json",
      "content": "{\n  \"name\": \"{{name}}\",\n  \"private\": true,\n  \"scripts\": {\n    \"build\": \"pnpm -r build\",\n    \"test\": \"pnpm -r test\",\n    \"typecheck\": \"pnpm -r typecheck\",\n    \"changeset\": \"changeset\",\n    \"release\": \"pnpm build && changeset publish\"\n  },\n  \"devDependencies\": {\n    \"@changesets/cli\": \"latest\",\n    \"tsup\": \"latest\",\n    \"typescript\": \"~5.9.0\",\n    \"vitest\": \"latest\"\n  }\n}\n"
    },
    {
      "path": "pnpm-workspace.yaml",
      "content": "packages:\n  - packages/*\n"
    },
    {
      "path": ".changeset/config.json",
      "content": "{\n  \"$schema\": \"https://unpkg.com/@changesets/config/schema.json\",\n  \"changelog\": \"@changesets/cli/changelog\",\n  \"commit\": false,\n  \"access\": \"public\",\n  \"baseBranch\": \"main\",\n  \"updateInternalDependencies\": \"patch\"\n}\n"
    },
    {
      "path": "packages/core/package.json",
      "content": "{\n  \"name\": \"@{{name}}/core\",\n  \"version\": \"0.0.0\",\n  \"type\": \"module\",\n  \"exports\": {\n    \".\": {\n      \"types\": \"./dist/index.d.ts\",\n      \"import\": \"./dist/index.js\"\n    }\n  },\n  \"main\": \"./dist/index.js\",\n  \"types\": \"./dist/index.d.ts\",\n  \"files\": [\n    \"dist\"\n  ],\n  \"scripts\": {\n    \"build\": \"tsup src/index.ts --format esm --dts --clean\",\n    \"test\": \"vitest run\",\n    \"typecheck\": \"tsc --noEmit\"\n  }\n}\n"
    },
    {
      "path": "packages/core/tsconfig.json",
      "content": "{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"module\": \"ESNext\",\n    \"moduleResolution\": \"bundler\",\n    \"strict\": true,\n    \"skipLibCheck\": true,\n    \"noEmit\": true,\n    \"types\": []\n  },\n  \"include\": [\n    \"src\"\n  ]\n}\n"
    },
    {
      "path": "packages/core/src/index.ts",
      "content": "/** Public API of @{{name}}/core: everything exported here is part of the contract. */\nexport function greet(name: string): string {\n  return `Hello, ${name}!`;\n}\n"
    },
    {
      "path": "packages/core/src/index.test.ts",
      "content": "import { expect, it } from \"vitest\";\n\nimport { greet } from \"./index\";\n\nit(\"greets\", () => {\n  expect(greet(\"Ana\")).toBe(\"Hello, Ana!\");\n});\n"
    },
    {
      "path": "packages/utils/package.json",
      "content": "{\n  \"name\": \"@{{name}}/utils\",\n  \"version\": \"0.0.0\",\n  \"type\": \"module\",\n  \"exports\": {\n    \".\": {\n      \"types\": \"./dist/index.d.ts\",\n      \"import\": \"./dist/index.js\"\n    }\n  },\n  \"main\": \"./dist/index.js\",\n  \"types\": \"./dist/index.d.ts\",\n  \"files\": [\n    \"dist\"\n  ],\n  \"scripts\": {\n    \"build\": \"tsup src/index.ts --format esm --dts --clean\",\n    \"test\": \"vitest run\",\n    \"typecheck\": \"tsc --noEmit\"\n  },\n  \"dependencies\": {\n    \"@{{name}}/core\": \"workspace:*\"\n  }\n}\n"
    },
    {
      "path": "packages/utils/tsconfig.json",
      "content": "{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"module\": \"ESNext\",\n    \"moduleResolution\": \"bundler\",\n    \"strict\": true,\n    \"skipLibCheck\": true,\n    \"noEmit\": true,\n    \"types\": []\n  },\n  \"include\": [\n    \"src\"\n  ]\n}\n"
    },
    {
      "path": "packages/utils/src/index.ts",
      "content": "import { greet } from \"@{{name}}/core\";\n\nexport function greetAll(names: string[]): string[] {\n  return names.map(greet);\n}\n"
    },
    {
      "path": "packages/utils/src/index.test.ts",
      "content": "import { expect, it } from \"vitest\";\n\nimport { greetAll } from \"./index\";\n\nit(\"greets everyone\", () => {\n  expect(greetAll([\"Ana\", \"Luis\"])).toEqual([\"Hello, Ana!\", \"Hello, Luis!\"]);\n});\n"
    },
    {
      "path": ".gitignore",
      "content": "node_modules\ndist\n"
    }
  ],
  "libraries": {
    "framework": "monorepo",
    "platforms": [
      "npm-package"
    ],
    "ci": [],
    "testing": [],
    "quality": [],
    "deploy": "none",
    "workflow": [
      "essentials"
    ],
    "security": [
      "security-pack"
    ]
  },
  "verify": {
    "command": "node scripts/workspace.mjs verify",
    "matrix": []
  },
  "instructions": "## How to work here\n\n- Each library is a folder in `packages/` with its own `package.json`; whatever `src/index.ts` exports is its public API.\n- One library uses another with `\"workspace:*\"`; pnpm turns it into the real version when publishing.\n- Every change that should be published gets a changeset: `pnpm changeset` (pick packages and version bump). Publish with `pnpm release`.\n- Before finishing: `pnpm build && pnpm test && pnpm typecheck`.\n",
  "skills": [
    "antfu/skills@pnpm",
    "wshobson/agents@typescript-advanced-types",
    "antfu/skills@vitest"
  ],
  "workspace": {
    "preserveBase": true,
    "services": {
      "web": {
        "label": "Web",
        "path": "apps/web",
        "default": "none",
        "variants": {
          "nextjs": "web-next@1.1.0",
          "react": "spa-vite-react@1.2.4",
          "vue": "web-vue-vite@1.1.4",
          "nuxt": "web-nuxt@1.2.4",
          "sveltekit": "web-sveltekit@1.2.4",
          "astro": "web-astro@1.2.4",
          "angular": "web-angular@1.1.4",
          "react-router": "web-react-router@1.1.4",
          "tanstack-start": "web-tanstack-start@1.1.4"
        }
      },
      "api": {
        "label": "Api",
        "path": "apps/api",
        "default": "none",
        "variants": {
          "django": "api-django@1.3.0",
          "fastapi": "api-fastapi@1.4.0",
          "hono": "api-hono@1.5.0",
          "express": "api-express@1.1.0",
          "fastify": "api-fastify@1.2.0",
          "nestjs": "api-nestjs@1.2.0",
          "elysia": "api-elysia@1.3.0",
          "go": "api-go@1.4.0",
          "rails": "api-rails@1.2.0",
          "spring": "api-spring-boot@1.3.0",
          "laravel": "api-laravel@1.2.0",
          "aspnet": "api-aspnet@1.1.0",
          "axum": "api-axum@1.1.0"
        }
      },
      "docs": {
        "label": "Docs",
        "path": "apps/docs",
        "default": "none",
        "variants": {
          "starlight": "docs-starlight@1.1.4",
          "vitepress": "docs-vitepress@1.1.4",
          "fumadocs": "docs-fumadocs@1.1.4"
        }
      },
      "mobile": {
        "label": "Mobile",
        "path": "apps/mobile",
        "default": "none",
        "variants": {
          "expo": "mobile-expo@1.4.4"
        }
      }
    },
    "nativeVerify": "pnpm build && pnpm test && pnpm typecheck",
    "nativeBase": {
      "command": "mkdir {{name}}"
    }
  },
  "minCliVersion": "1.1.0",
  "options": [
    {
      "id": "deployment",
      "label": "Deployment mode",
      "default": "none",
      "choices": [
        {
          "id": "none",
          "label": "Configure later"
        },
        {
          "id": "independent",
          "label": "Independent services"
        },
        {
          "id": "compose",
          "label": "Docker Compose"
        }
      ]
    }
  ]
}
