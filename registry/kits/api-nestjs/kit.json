{
  "$schema": "../../kit.schema.json",
  "version": "1.2.0",
  "author": "marlon-chaviano",
  "name": "api-nestjs",
  "title": "API with NestJS",
  "category": "api",
  "language": "typescript",
  "description": "A TypeScript API with NestJS modules, controllers and Jest. Choose authentication, storage and API documentation, and install the official NestJS agent skills.",
  "tags": [
    "nestjs",
    "api",
    "typescript",
    "node"
  ],
  "base": {
    "command": "npx -y @nestjs/cli@12 new {{name}} --package-manager {{pm}} --type cjs --no-observe --skip-skills --no-interactive --skip-git --skip-install --strict",
    "install": "{{pm}} install"
  },
  "packageManagers": [
    "npm",
    "pnpm",
    "bun"
  ],
  "libraries": {
    "framework": "nodejs",
    "email": "none",
    "ai": [],
    "ci": [],
    "deploy": "none",
    "workflow": [
      "essentials"
    ],
    "security": [
      "security-pack"
    ],
    "auth": "none",
    "database": "none",
    "observability": [],
    "payments": "none",
    "quality": [],
    "testing": [],
    "forms": [],
    "platforms": [
      "http-api",
      "nestjs"
    ]
  },
  "verify": {
    "command": "{{pm}} run build && {{pm}} run test",
    "matrix": [
      {
        "quality": [
          "nestjs-swagger"
        ]
      },
      {
        "email": [
          "resend"
        ],
        "ai": [
          "claude-api"
        ],
        "ci": [
          "github-actions"
        ],
        "deploy": [
          "docker"
        ],
        "quality": [
          "openapi-contract"
        ]
      }
    ]
  },
  "instructions": "## How to work here\n\n- Organize by domain modules (`src/<domain>/`), each with its module, controller and service. Generate pieces with `npx nest g resource <name>`.\n- Logic lives in services; controllers only translate HTTP. Inject dependencies through the constructor.\n- Validate input with DTOs and `ValidationPipe`.\n- Before finishing: `npm run build && npm test`.",
  "skills": [
    "nestjs/agent-skills@nestjs",
    "nestjs/agent-skills@nestjs-feature",
    "nestjs/agent-skills@nestjs-auth",
    "nestjs/agent-skills@nestjs-data",
    "nestjs/agent-skills@nestjs-testing",
    "nestjs/agent-skills@nestjs-production"
  ],
  "service": {
    "dev": "{{pm}} run start:dev",
    "build": "{{pm}} run build",
    "start": "{{pm}} run start:prod",
    "port": 8000,
    "install": "npm install",
    "ci": [],
    "dockerfile": "FROM node:22-slim\nWORKDIR /app\nRUN npm install -g pnpm bun serve\nCOPY {{servicePath}}/ .\nRUN {{pm}} install\nRUN {{pm}} run build\nENV NODE_ENV=production\nENV PORT=8000\nEXPOSE 8000\nCMD [\"sh\", \"-c\", \"{{pm}} run start:prod\"]\n",
    "health": "/",
    "connect": [
      {
        "path": "src/main.ts",
        "mode": "replace",
        "anchor": "  await app.listen(",
        "content": "  app.enableCors({ origin: (process.env.WEB_ORIGINS ?? '{{webOrigin}}').split(',') });\n  await app.listen("
      }
    ]
  }
}
