{
  "$schema": "../../kit.schema.json",
  "name": "api-hono",
  "version": "1.4.0",
  "title": "API with Hono",
  "description": "Typed REST API with Hono on Node, Bun or Cloudflare Workers. Validation with Zod and an optional Drizzle database.",
  "category": "api",
  "tags": [
    "hono",
    "api",
    "typescript",
    "zod",
    "drizzle"
  ],
  "author": "Marlon Chaviano",
  "base": {
    "command": "npx create-hono@latest {{name}} --template {{opt.runtime}} --pm {{pm}} --install"
  },
  "verify": {
    "command": "npx tsc --noEmit && npm run --if-present test",
    "matrix": [
      {
        "db": [
          "drizzle-postgres"
        ],
        "observability": [
          "sentry-node",
          "posthog-node"
        ]
      },
      {
        "email": [
          "resend"
        ],
        "ai": [
          "claude-api"
        ],
        "testing": [
          "vitest-node"
        ],
        "quality": [
          "biome"
        ],
        "ci": [
          "github-actions"
        ],
        "deploy": [
          "docker"
        ]
      },
      {
        "deploy": [
          "fly"
        ]
      }
    ]
  },
  "skills": [
    "honojs/skills@hono",
    "wshobson/agents@typescript-advanced-types",
    "wshobson/agents@api-design-principles"
  ],
  "options": [
    {
      "id": "runtime",
      "label": "Runtime",
      "default": "nodejs",
      "choices": [
        {
          "id": "nodejs",
          "label": "Node.js",
          "skills": [
            "mcollina/skills@node",
            "wshobson/agents@nodejs-backend-patterns",
            "wshobson/agents@typescript-advanced-types"
          ]
        },
        {
          "id": "bun",
          "label": "Bun",
          "skills": [
            "affaan-m/ecc@bun-runtime"
          ]
        },
        {
          "id": "cloudflare-workers",
          "label": "Cloudflare Workers",
          "skills": [
            "cloudflare/skills@cloudflare",
            "cloudflare/skills@workers-best-practices",
            "cloudflare/skills@wrangler"
          ]
        }
      ]
    },
    {
      "id": "validation",
      "label": "Validation",
      "default": "zod",
      "choices": [
        {
          "id": "zod",
          "label": "Zod",
          "dependencies": [
            "zod",
            "@hono/zod-validator"
          ],
          "instructions": "## Validation\n\nValidate params, query and body on every route with `zValidator` from `@hono/zod-validator`. Never read `c.req.json()` without validating it."
        },
        {
          "id": "none",
          "label": "None"
        }
      ]
    },
    {
      "id": "db",
      "label": "Database",
      "default": "none",
      "choices": [
        {
          "id": "none",
          "label": "None"
        },
        {
          "id": "drizzle-postgres",
          "label": "Drizzle + Postgres",
          "dependencies": [
            "drizzle-orm",
            "postgres"
          ],
          "devDependencies": [
            "drizzle-kit"
          ],
          "env": {
            "DATABASE_URL": "postgres://postgres:postgres@localhost:5432/app"
          },
          "files": "files/drizzle",
          "instructions": "## Database\n\nSchema in `src/db/schema.ts`, client in `src/db/index.ts`. After changing the schema: `npx drizzle-kit generate` and `npx drizzle-kit migrate`. Never edit migrations that were already applied.",
          "skills": [
            "giuseppe-trisciuoglio/developer-kit@drizzle-orm-patterns",
            "supabase/agent-skills@supabase-postgres-best-practices"
          ]
        }
      ]
    }
  ],
  "instructions": "## How to work here\n\n- Group routes by resource with `new Hono()` and `app.route('/resource', router)`.\n- Export the app's type (`export type AppType = typeof app`) to use the `hc` RPC client from the frontend.",
  "libraries": {
    "framework": {
      "option": "runtime"
    },
    "observability": [],
    "email": "none",
    "ai": [],
    "testing": [],
    "quality": [],
    "ci": [],
    "deploy": "none",
    "workflow": [
      "essentials"
    ]
  },
  "language": "typescript"
}
