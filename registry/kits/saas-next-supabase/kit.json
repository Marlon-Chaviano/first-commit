{
  "$schema": "../../kit.schema.json",
  "name": "saas-next-supabase",
  "version": "1.3.1",
  "title": "SaaS with Next.js + Supabase",
  "description": "Next.js with Supabase (auth and Postgres) and pieces from the catalog: Better Auth or Clerk, Drizzle, Stripe, Resend, i18n, AI, tests, CI and deployment, with their MCP servers and rules for your agent.",
  "category": "saas",
  "tags": [
    "nextjs",
    "supabase",
    "stripe",
    "auth",
    "postgres"
  ],
  "author": "Marlon Chaviano",
  "base": {
    "command": "npx create-next-app@latest {{name}} --ts --tailwind --eslint --app --src-dir --import-alias \"@/*\" --use-{{pm}} --disable-git --no-agent-feedback --yes"
  },
  "verify": {
    "command": "{{pm}} run build && npm run --if-present test",
    "matrix": [
      {
        "auth": [
          "better-auth"
        ],
        "database": [
          "drizzle-postgres"
        ],
        "payments": [
          "stripe"
        ],
        "email": [
          "resend"
        ],
        "testing": [
          "vitest",
          "playwright"
        ],
        "ci": [
          "github-actions"
        ],
        "observability": [
          "sentry-nextjs"
        ]
      },
      {
        "auth": [
          "clerk"
        ],
        "payments": [
          "none"
        ],
        "email": [
          "react-email"
        ],
        "i18n": [
          "next-intl"
        ],
        "ai": [
          "vercel-ai-sdk",
          "claude-api"
        ],
        "quality": [
          "biome"
        ],
        "deploy": [
          "docker"
        ],
        "observability": [
          "posthog-nextjs"
        ]
      },
      {
        "state": [
          "zustand"
        ],
        "data": [
          "tanstack-query"
        ],
        "forms": [
          "react-hook-form"
        ]
      },
      {
        "database": [
          "drizzle-neon"
        ],
        "payments": [
          "lemonsqueezy"
        ],
        "deploy": [
          "netlify"
        ]
      },
      {
        "database": [
          "drizzle-turso"
        ],
        "payments": [
          "polar"
        ],
        "deploy": [
          "render"
        ]
      },
      {
        "database": [
          "mongoose"
        ],
        "payments": [
          "paddle"
        ],
        "deploy": [
          "railway"
        ]
      },
      {
        "payments": [
          "mercadopago"
        ],
        "deploy": [
          "fly"
        ]
      }
    ]
  },
  "dependencies": [
    "@supabase/supabase-js",
    "@supabase/ssr"
  ],
  "skills": [
    "supabase/agent-skills@supabase",
    "supabase/agent-skills@supabase-postgres-best-practices",
    "vercel-labs/agent-skills@vercel-react-best-practices"
  ],
  "mcp": {
    "supabase": {
      "url": "https://mcp.supabase.com/mcp"
    }
  },
  "env": {
    "NEXT_PUBLIC_SUPABASE_URL": "",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": ""
  },
  "files": "files/supabase",
  "options": [],
  "libraries": {
    "framework": [
      "react",
      "nextjs"
    ],
    "components": "shadcn",
    "addons": [],
    "animation": [],
    "auth": "none",
    "database": "none",
    "payments": "stripe",
    "email": "none",
    "i18n": "none",
    "ai": [],
    "observability": [
      "sentry-nextjs"
    ],
    "testing": [],
    "quality": [],
    "ci": [],
    "deploy": "none",
    "design": [
      "design-pack"
    ],
    "workflow": [
      "essentials"
    ],
    "state": "none",
    "data": "none",
    "forms": []
  },
  "instructions": "## How to work here\n\n- Supabase clients in `src/lib/supabase/`: `client.ts` in client components, `server.ts` in Server Components, Route Handlers and Server Actions.\n- Every new table gets RLS. Use the Supabase MCP to look at the schema before writing queries.\n- To refresh the session on every request, follow the current `@supabase/ssr` guide for Next.js (the `supabase` skill has it).",
  "language": "typescript"
}
