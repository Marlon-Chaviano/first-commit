{
  "$schema": "../../kit.schema.json",
  "name": "mobile-expo",
  "version": "1.4.0",
  "title": "Mobile app with Expo",
  "description": "React Native + Expo Router ready for iOS, Android and web, with Expo's official skills so your agent doesn't reach for outdated APIs.",
  "category": "mobile",
  "tags": [
    "react-native",
    "expo",
    "expo-router",
    "typescript"
  ],
  "author": "Marlon Chaviano",
  "base": {
    "command": "npx create-expo-app@latest {{name}} --template default --no-install --yes",
    "install": "{{pm}} install"
  },
  "addCommand": {
    "dependencies": "{{pmx}} expo install {{packages}}",
    "devDependencies": "{{pmx}} expo install {{packages}} -- -D"
  },
  "verify": {
    "command": "npx expo export --platform web --output-dir .verify-export && npm run --if-present test -- --ci",
    "matrix": [
      {
        "styling": [
          "nativewind"
        ],
        "backend": [
          "supabase"
        ]
      },
      {
        "i18n": [
          "i18next-expo"
        ],
        "testing": [
          "jest-expo"
        ],
        "deploy": [
          "eas"
        ]
      },
      {
        "state": [
          "zustand"
        ],
        "data": [
          "tanstack-query"
        ],
        "forms": [
          "react-hook-form"
        ]
      }
    ]
  },
  "skills": [
    "expo/skills@expo-overview",
    "expo/skills@expo-router",
    "expo/skills@expo-native-ui",
    "expo/skills@expo-ui",
    "expo/skills@expo-project-structure",
    "expo/skills@expo-design-system",
    "expo/skills@expo-data-fetching",
    "expo/skills@expo-animation",
    "expo/skills@expo-dev-client",
    "expo/skills@expo-upgrade",
    "vercel-labs/agent-skills@vercel-react-native-skills",
    "callstackincubator/agent-skills@react-native-best-practices",
    "callstackincubator/agent-skills@upgrading-react-native",
    "wshobson/agents@typescript-advanced-types"
  ],
  "options": [
    {
      "id": "styling",
      "label": "Styling",
      "default": "stylesheet",
      "choices": [
        {
          "id": "stylesheet",
          "label": "StyleSheet + Expo theme",
          "description": "The theming system that ships with the official template."
        },
        {
          "id": "nativewind",
          "label": "NativeWind (Tailwind)",
          "description": "Tailwind classes in React Native.",
          "dependencies": [
            "nativewind",
            "react-native-css-interop",
            "react-native-reanimated",
            "react-native-safe-area-context"
          ],
          "devDependencies": [
            "tailwindcss@^3.4.17",
            "babel-preset-expo"
          ],
          "files": "files/nativewind",
          "instructions": "## Styling\n\nThis project uses **NativeWind v4** (Tailwind 3). Write styles with `className`; design tokens live in `tailwind.config.js` and `src/global.css`. Don't mix in `StyleSheet.create` except for animations."
        }
      ]
    },
    {
      "id": "backend",
      "label": "Backend",
      "default": "none",
      "choices": [
        {
          "id": "none",
          "label": "None"
        },
        {
          "id": "supabase",
          "label": "Supabase",
          "description": "Auth, Postgres and storage. Includes a configured client and the Supabase MCP.",
          "dependencies": [
            "@supabase/supabase-js",
            "@react-native-async-storage/async-storage",
            "react-native-url-polyfill"
          ],
          "skills": [
            "supabase/agent-skills@supabase",
            "supabase/agent-skills@supabase-postgres-best-practices"
          ],
          "mcp": {
            "supabase": {
              "url": "https://mcp.supabase.com/mcp"
            }
          },
          "env": {
            "EXPO_PUBLIC_SUPABASE_URL": "",
            "EXPO_PUBLIC_SUPABASE_ANON_KEY": ""
          },
          "files": "files/supabase",
          "instructions": "## Backend\n\nSupabase is configured in `src/lib/supabase.ts` (session persisted with AsyncStorage). Fill in `.env` from `.env.example`. Use the Supabase MCP to inspect the schema before writing queries, and protect every table with RLS."
        }
      ]
    }
  ],
  "libraries": {
    "framework": [
      "react-native",
      "expo"
    ],
    "components": "none",
    "animation": [],
    "observability": [],
    "i18n": "none",
    "testing": [],
    "deploy": "none",
    "design": [
      "design-pack-native"
    ],
    "workflow": [
      "essentials"
    ],
    "state": "none",
    "data": "none",
    "forms": []
  },
  "instructions": "## How to work here\n\n- Screens in `src/app/` (Expo Router); components in `src/components/`.\n- Add dependencies with `npx expo install`, never with `npm install` directly.\n- Before finishing a task: `npx tsc --noEmit` and `npx expo lint`.",
  "language": "typescript"
}
