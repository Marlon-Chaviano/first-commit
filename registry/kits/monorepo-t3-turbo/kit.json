{
  "$schema": "../../kit.schema.json",
  "version": "2.1.0",
  "author": "marlon-chaviano",
  "name": "monorepo-t3-turbo",
  "title": "T3 monorepo with Turborepo",
  "category": "monorepo",
  "language": "typescript",
  "description": "create-t3-turbo: Next.js and Expo in the same repo sharing an API with tRPC, Drizzle, Better Auth and UI, all typed end to end with Turborepo.",
  "tags": [
    "t3",
    "turborepo",
    "nextjs",
    "expo",
    "trpc",
    "drizzle"
  ],
  "base": {
    "command": "echo 'This workspace needs CLI version 1.1.0 or newer. Update the CLI and try again.' >&2; exit 1"
  },
  "packageManagers": [
    "pnpm"
  ],
  "skills": [
    "vercel/turborepo@turborepo",
    "antfu/skills@pnpm",
    "vercel-labs/agent-skills@vercel-react-best-practices",
    "vercel-labs/agent-skills@vercel-composition-patterns",
    "wshobson/agents@typescript-advanced-types",
    "vercel/next.js@next-dev-loop",
    "vercel/next.js@next-bundle-optimizer",
    "wshobson/agents@nextjs-app-router-patterns",
    "better-auth/skills@better-auth-best-practices",
    "better-auth/skills@better-auth-security-best-practices",
    "better-auth/skills@create-auth",
    "better-auth/skills@email-and-password-best-practices",
    "better-auth/skills@organization-best-practices",
    "better-auth/skills@two-factor-authentication-best-practices",
    "giuseppe-trisciuoglio/developer-kit@drizzle-orm-patterns",
    "expo/skills@expo-overview",
    "expo/skills@expo-router"
  ],
  "libraries": {
    "framework": "monorepo",
    "design": [
      "design-pack"
    ],
    "workflow": [
      "essentials"
    ],
    "security": [
      "security-pack"
    ],
    "ci": [],
    "quality": [],
    "testing": []
  },
  "verify": {
    "command": "node scripts/workspace.mjs verify",
    "matrix": []
  },
  "instructions": "## How to work here\n\n- Apps in `apps/` (`nextjs`, `expo`) and packages in `packages/` (`api` with the tRPC routers, `db` with Drizzle, `auth`, `ui`, `validators`).\n- The API is written once in `packages/api` and both web and mobile use it; never duplicate an endpoint inside an app.\n- Run from the root: `pnpm dev`, `pnpm build`, `pnpm typecheck`, `pnpm lint`.\n- Each app lives in its own folder with its own dependencies; don't mix code from one into another.\n- Whatever backend and frontend share (types, API contracts) is defined in one place and documented.\n",
  "workspace": {
    "preserveBase": true,
    "services": {
      "web": {
        "label": "Web",
        "path": "apps/nextjs",
        "default": "nextjs",
        "variants": {
          "nextjs": "web-next@1.1.0",
          "react": "spa-vite-react@1.2.4",
          "vue": "web-vue-vite@1.1.4",
          "nuxt": "web-nuxt@1.2.4",
          "sveltekit": "web-sveltekit@1.2.4",
          "astro": "web-astro@1.2.4",
          "angular": "web-angular@1.1.4",
          "react-router": "web-react-router@1.1.4",
          "tanstack-start": "web-tanstack-start@1.1.4"
        },
        "existing": true
      },
      "api": {
        "label": "Api",
        "path": "apps/api",
        "default": "none",
        "variants": {
          "django": "api-django@1.3.0",
          "fastapi": "api-fastapi@1.4.0",
          "hono": "api-hono@1.5.0",
          "express": "api-express@1.1.0",
          "fastify": "api-fastify@1.2.0",
          "nestjs": "api-nestjs@1.2.0",
          "elysia": "api-elysia@1.3.0",
          "go": "api-go@1.4.0",
          "rails": "api-rails@1.2.0",
          "spring": "api-spring-boot@1.3.0",
          "laravel": "api-laravel@1.2.0",
          "aspnet": "api-aspnet@1.1.0",
          "axum": "api-axum@1.1.0"
        }
      },
      "docs": {
        "label": "Docs",
        "path": "apps/docs",
        "default": "none",
        "variants": {
          "starlight": "docs-starlight@1.1.4",
          "vitepress": "docs-vitepress@1.1.4",
          "fumadocs": "docs-fumadocs@1.1.4"
        }
      },
      "mobile": {
        "label": "Mobile",
        "path": "apps/expo",
        "default": "expo",
        "variants": {
          "expo": "mobile-expo@1.4.4"
        },
        "existing": true
      }
    },
    "nativeVerify": "SKIP_ENV_VALIDATION=1 pnpm turbo run build --filter=./apps/nextjs",
    "nativeBase": {
      "command": "npx -y create-turbo@latest {{name}} -e https://github.com/t3-oss/create-t3-turbo -m pnpm --skip-install --no-git",
      "install": "pnpm install"
    },
    "preserveWhen": {
      "api": [
        "none"
      ]
    }
  },
  "minCliVersion": "1.1.0",
  "options": [
    {
      "id": "deployment",
      "label": "Deployment mode",
      "default": "none",
      "choices": [
        {
          "id": "none",
          "label": "Configure later"
        },
        {
          "id": "independent",
          "label": "Independent services"
        },
        {
          "id": "compose",
          "label": "Docker Compose"
        }
      ]
    }
  ]
}
