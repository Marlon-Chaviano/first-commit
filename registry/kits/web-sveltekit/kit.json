{
  "$schema": "../../kit.schema.json",
  "name": "web-sveltekit",
  "version": "1.2.0",
  "author": "Marlon Chaviano",
  "title": "Web app with SvelteKit",
  "category": "web",
  "language": "typescript",
  "description": "SvelteKit with Svelte 5 and TypeScript: file-system routes, server-side data loading and Svelte's official skills.",
  "tags": [
    "svelte",
    "sveltekit",
    "typescript"
  ],
  "base": {
    "command": "npx sv@latest create {{name}} --template minimal --types ts --no-add-ons --no-install",
    "install": "{{pm}} install"
  },
  "skills": [
    "sveltejs/ai-tools@svelte-code-writer",
    "sveltejs/ai-tools@svelte-core-bestpractices",
    "ejirocodes/agent-skills@svelte5-best-practices",
    "spences10/svelte-skills-kit@svelte-runes",
    "spences10/svelte-skills-kit@svelte-components",
    "spences10/svelte-skills-kit@svelte-styling",
    "wshobson/agents@typescript-advanced-types",
    "spences10/svelte-skills-kit@sveltekit-structure",
    "spences10/svelte-skills-kit@sveltekit-data-flow",
    "spences10/svelte-skills-kit@sveltekit-remote-functions",
    "spences10/svelte-skills-kit@svelte-deployment"
  ],
  "verify": {
    "command": "{{pm}} run build",
    "matrix": [
      {
        "styling-lib": [
          "tailwind-sveltekit"
        ],
        "data": [
          "tanstack-query-svelte"
        ],
        "forms": [
          "zod"
        ]
      }
    ]
  },
  "libraries": {
    "framework": [
      "svelte",
      "sveltekit"
    ],
    "animation": [],
    "design": [
      "design-pack"
    ],
    "workflow": [
      "essentials"
    ],
    "styling": "none",
    "data": "none",
    "forms": []
  },
  "instructions": "## How to work here\n\n- Routes in `src/routes/` (`+page.svelte`, `+page.server.ts` to load data on the server).\n- Svelte 5: use runes (`$state`, `$derived`, `$props`), not the old syntax (`export let`, `$:`).\n- Before finishing: `npm run check` and `npm run build`."
}
