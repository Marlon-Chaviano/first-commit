{
  "$schema": "../../kit.schema.json",
  "version": "1.2.0",
  "author": "marlon-chaviano",
  "name": "api-laravel",
  "title": "API with Laravel",
  "category": "api",
  "language": "php",
  "description": "Laravel as an API: routes in routes/api.php, token auth with Sanctum, Eloquent, validation with Form Requests and tests ready to go.",
  "tags": [
    "php",
    "laravel",
    "api",
    "sanctum",
    "eloquent"
  ],
  "base": {
    "command": "command -v composer >/dev/null || { echo 'Composer is required: https://getcomposer.org' >&2; exit 1; }; composer create-project laravel/laravel {{name}} --no-interaction --prefer-dist --quiet"
  },
  "packageManagers": [
    "composer"
  ],
  "skills": [
    "laravel/boost@laravel-best-practices",
    "jeffallan/claude-skills@laravel-specialist",
    "jeffallan/claude-skills@php-pro",
    "affaan-m/ecc@laravel-patterns",
    "affaan-m/ecc@laravel-security",
    "affaan-m/ecc@laravel-tdd"
  ],
  "libraries": {
    "framework": [
      "laravel"
    ],
    "auth": "laravel-sanctum",
    "testing": [],
    "workflow": [
      "essentials"
    ],
    "security": [
      "security-pack"
    ],
    "ci": [],
    "database": "none",
    "deploy": "none",
    "email": "none",
    "observability": [],
    "payments": "none",
    "i18n": "none",
    "quality": [],
    "platforms": [
      "http-api"
    ]
  },
  "verify": {
    "command": "php artisan test",
    "matrix": [
      {
        "testing": [
          "pest"
        ]
      },
      {
        "database": [
          "laravel-eloquent"
        ],
        "payments": [
          "stripe-php"
        ],
        "email": [
          "resend-laravel"
        ],
        "i18n": [
          "laravel-localization"
        ],
        "observability": [
          "sentry-laravel"
        ],
        "ci": [
          "github-actions-laravel"
        ],
        "deploy": [
          "railway-laravel"
        ]
      },
      {
        "quality": [
          "laravel-pint"
        ]
      }
    ]
  },
  "instructions": "## How to work here\n\n- API routes go in `routes/api.php` (prefix `/api`); protect them with `auth:sanctum`.\n- Respond with API Resources (`php artisan make:resource`) and validate with Form Requests (`php artisan make:request`); never return models as they are.\n- Database changes only through migrations.\n- Before finishing: `php artisan test`.",
  "service": {
    "dev": "php artisan serve --host=0.0.0.0 --port=8000",
    "build": "php artisan test",
    "start": "php artisan serve --host=0.0.0.0 --port=8000",
    "port": 8000,
    "install": "composer install",
    "ci": [
      {
        "uses": "shivammathur/setup-php@v2",
        "with": {
          "php-version": "8.3"
        }
      }
    ],
    "health": "/up",
    "connect": [
      {
        "path": "config/cors.php",
        "content": "<?php\nreturn [\n 'paths' => ['*'],\n 'allowed_methods' => ['GET', 'POST', 'PUT', 'PATCH', 'DELETE', 'OPTIONS'],\n 'allowed_origins' => explode(',', env('WEB_ORIGINS', '{{webOrigin}}')),\n 'allowed_origins_patterns' => [],\n 'allowed_headers' => ['Content-Type', 'Authorization'],\n 'exposed_headers' => [],\n 'max_age' => 0,\n 'supports_credentials' => false,\n];\n"
      }
    ]
  }
}
