{
  "$schema": "../../kit.schema.json",
  "name": "chrome-extension",
  "version": "1.4.1",
  "title": "Browser extension with WXT",
  "description": "An extension for Chrome, Firefox and Edge with WXT (Manifest V3, hot reload) and the UI framework you prefer.",
  "category": "extension",
  "tags": [
    "chrome-extension",
    "wxt",
    "manifest-v3"
  ],
  "author": "marlon-chaviano",
  "base": {
    "command": "npx wxt@latest init {{name}} --template {{opt.framework}} --pm {{pm}}",
    "install": "{{pm}} install"
  },
  "verify": {
    "command": "{{pm}} run build",
    "matrix": [
      {
        "framework": [
          "vue"
        ],
        "components": [
          "primevue"
        ],
        "animation": [
          "motion-vue"
        ]
      },
      {
        "framework": [
          "react"
        ],
        "quality": [
          "biome"
        ],
        "ci": [
          "github-actions"
        ]
      }
    ]
  },
  "skills": [
    "googlechrome/modern-web-guidance@chrome-extensions",
    "pproenca/dot-skills@wxt-browser-extensions",
    "wshobson/agents@typescript-advanced-types"
  ],
  "options": [
    {
      "id": "framework",
      "label": "UI framework",
      "default": "react",
      "choices": [
        {
          "id": "react",
          "label": "React",
          "skills": [
            "vercel-labs/agent-skills@vercel-react-best-practices",
            "vercel-labs/agent-skills@vercel-composition-patterns",
            "wshobson/agents@typescript-advanced-types"
          ]
        },
        {
          "id": "vue",
          "label": "Vue",
          "skills": [
            "vuejs-ai/skills@vue-best-practices",
            "vuejs-ai/skills@vue-router-best-practices",
            "vuejs-ai/skills@vue-pinia-best-practices",
            "vuejs-ai/skills@vue-testing-best-practices",
            "vuejs-ai/skills@vue-debug-guides",
            "vuejs-ai/skills@create-adaptable-composable",
            "antfu/skills@vue",
            "wshobson/agents@typescript-advanced-types"
          ]
        },
        {
          "id": "svelte",
          "label": "Svelte",
          "skills": [
            "sveltejs/ai-tools@svelte-code-writer",
            "sveltejs/ai-tools@svelte-core-bestpractices",
            "ejirocodes/agent-skills@svelte5-best-practices",
            "spences10/svelte-skills-kit@svelte-runes",
            "spences10/svelte-skills-kit@svelte-components",
            "spences10/svelte-skills-kit@svelte-styling",
            "wshobson/agents@typescript-advanced-types"
          ]
        },
        {
          "id": "solid",
          "label": "Solid"
        },
        {
          "id": "vanilla",
          "label": "Vanilla TS"
        }
      ]
    }
  ],
  "libraries": {
    "framework": {
      "option": "framework"
    },
    "components": "none",
    "addons": [],
    "animation": [],
    "quality": [],
    "ci": [],
    "design": [
      "design-pack"
    ],
    "workflow": [
      "essentials"
    ]
  },
  "instructions": "## How to work here\n\n- Entry points in `entrypoints/` (popup, background, content scripts); WXT generates the manifest from them.\n- Request only the minimum permissions in `wxt.config.ts`.\n- `npm run dev` opens a browser with the extension loaded and hot reload.",
  "language": "typescript"
}
