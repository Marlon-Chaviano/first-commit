{
  "$schema": "../../kit.schema.json",
  "name": "chrome-extension",
  "version": "1.3.0",
  "title": "Browser extension with WXT",
  "description": "An extension for Chrome, Firefox and Edge with WXT (Manifest V3, hot reload) and the UI framework you prefer.",
  "category": "extension",
  "tags": [
    "chrome-extension",
    "wxt",
    "manifest-v3"
  ],
  "author": "Marlon Chaviano",
  "base": {
    "command": "npx wxt@latest init {{name}} --template {{opt.framework}} --pm {{pm}}",
    "install": "{{pm}} install"
  },
  "verify": {
    "command": "{{pm}} run build",
    "matrix": [
      {
        "framework": [
          "vue"
        ],
        "components": [
          "primevue"
        ],
        "animation": [
          "motion-vue"
        ]
      },
      {
        "framework": [
          "react"
        ],
        "quality": [
          "biome"
        ],
        "ci": [
          "github-actions"
        ]
      }
    ]
  },
  "skills": [
    "googlechrome/modern-web-guidance@chrome-extensions",
    "pproenca/dot-skills@wxt-browser-extensions"
  ],
  "options": [
    {
      "id": "framework",
      "label": "UI framework",
      "default": "react",
      "choices": [
        {
          "id": "react",
          "label": "React",
          "skills": [
            "vercel-labs/agent-skills@vercel-react-best-practices"
          ]
        },
        {
          "id": "vue",
          "label": "Vue",
          "skills": [
            "vuejs-ai/skills@vue-best-practices"
          ]
        },
        {
          "id": "svelte",
          "label": "Svelte",
          "skills": [
            "sveltejs/ai-tools@svelte-code-writer",
            "sveltejs/ai-tools@svelte-core-bestpractices"
          ]
        },
        {
          "id": "solid",
          "label": "Solid"
        },
        {
          "id": "vanilla",
          "label": "Vanilla TS"
        }
      ]
    }
  ],
  "libraries": {
    "framework": {
      "option": "framework"
    },
    "components": "none",
    "addons": [],
    "animation": [],
    "quality": [],
    "ci": [],
    "design": [
      "design-pack"
    ],
    "workflow": [
      "essentials"
    ]
  },
  "instructions": "## How to work here\n\n- Entry points in `entrypoints/` (popup, background, content scripts); WXT generates the manifest from them.\n- Request only the minimum permissions in `wxt.config.ts`.\n- `npm run dev` opens a browser with the extension loaded and hot reload.",
  "language": "typescript"
}
