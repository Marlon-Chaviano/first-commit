                "label": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "requires": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "dependencies": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "devDependencies": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "skills": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[\\w.-]+\\/[\\w.-]+@[\\w.:-]+$"
                  }
                },
                "mcp": {
                  "default": {},
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
