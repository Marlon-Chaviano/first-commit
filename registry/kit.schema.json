          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "type": {
            "default": "select",
            "type": "string",
            "enum": [
              "select",
              "multi"
            ]
          },
          "default": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "choices": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+$"
