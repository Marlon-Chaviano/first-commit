                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "command": {
                            "type": "string"
                          },
                          "args": {
                            "default": [],
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "env": {
                            "type": "object",
                            "propertyNames": {
                              "type": "string"
                            },
                            "additionalProperties": {
                              "type": "string"
                            }
                          }
                        },
                        "required": [
                          "command"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "url": {
                            "type": "string",
                            "format": "uri"
                          },
                          "headers": {
                            "type": "object",
                            "propertyNames": {
                              "type": "string"
                            },
                            "additionalProperties": {
                              "type": "string"
                            }
                          }
                        },
                        "required": [
                          "url"
                        ]
                      }
                    ]
                  }
                },
                "env": {
                  "default": {},
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "files": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  ]
                },
                "instructions": {
                  "type": "string"
                },
                "postInstall": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "writeFiles": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "pattern": "^(?!\\/)(?!(?:.*\\/)?\\.\\.(?:\\/|$))[\\w./@()+[\\]-]+$"
                      },
                      "content": {
                        "type": "string"
                      },
                      "mode": {
                        "default": "create",
                        "type": "string",
                        "enum": [
                          "create",
                          "append",
                          "prepend",
                          "insert-before",
                          "replace",
                          "json-merge"
                        ]
                      },
                      "anchor": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "path",
                      "content"
                    ]
                  }
                },
                "setupTasks": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "id",
                "label"
              ]
            }
          }
        },
        "required": [
          "id",
          "label",
          "default",
          "choices"
        ]
      }
