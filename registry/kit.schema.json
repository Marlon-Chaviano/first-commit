  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "minCliVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[\\w.]+)?$"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[\\w.]+)?$"
    },
    "extends": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "mobile",
        "web",
        "landing",
        "saas",
        "api",
        "desktop",
        "extension",
        "monorepo",
        "other"
      ]
    },
    "tags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "author": {
      "type": "string"
    },
    "base": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string"
        },
        "install": {
          "type": "string"
        }
      },
      "required": [
        "command"
      ]
    },
    "finalize": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "addCommand": {
      "type": "object",
      "properties": {
        "dependencies": {
          "type": "string"
        },
        "devDependencies": {
          "type": "string"
        }
      }
    },
    "packageManagers": {
      "default": [
        "npm",
        "pnpm",
        "bun"
      ],
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "npm",
          "pnpm",
          "bun",
          "deno",
          "uv",
          "pip",
          "go",
          "swift",
          "bundler",
          "composer",
          "maven",
          "cargo",
          "gradle",
          "dotnet",
          "flutter"
        ]
      }
    },
    "language": {
      "type": "string",
      "enum": [
        "typescript",
        "python",
        "go",
        "ruby",
        "php",
        "java",
        "swift",
        "rust",
        "kotlin",
        "dart",
        "elixir",
        "csharp"
      ]
    },
    "verify": {
      "type": "object",
      "properties": {
        "command": {
          "default": "{{pm}} run build",
          "type": "string"
        },
        "matrix": {
          "type": "array",
          "items": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "dev": {
          "type": "string"
        },
        "build": {
          "type": "string"
        },
        "start": {
          "type": "string"
        },
        "verify": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "health": {
          "type": "string"
        },
        "options": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "connect": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(?!\\/)(?!(?:.*\\/)?\\.\\.(?:\\/|$))[\\w./@()+[\\]-]+$"
              },
              "content": {
                "type": "string"
              },
              "mode": {
                "default": "create",
                "type": "string",
                "enum": [
                  "create",
                  "append",
                  "prepend",
                  "insert-before",
                  "replace",
                  "json-merge"
                ]
              },
              "anchor": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "content"
            ]
          }
        },
        "client": {
          "type": "object",
          "properties": {
            "env": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            },
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^(?!\\/)(?!(?:.*\\/)?\\.\\.(?:\\/|$))[\\w./@()+[\\]-]+$"
                  },
                  "content": {
                    "type": "string"
                  },
                  "mode": {
                    "default": "create",
                    "type": "string",
                    "enum": [
                      "create",
                      "append",
                      "prepend",
                      "insert-before",
                      "replace",
                      "json-merge"
                    ]
                  },
                  "anchor": {
                    "type": "string"
                  }
                },
                "required": [
                  "path",
                  "content"
                ]
              }
            }
          },
          "required": [
            "files"
          ]
        },
        "dockerfile": {
          "type": "string"
        },
        "install": {
          "type": "string"
        },
        "ci": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "uses": {
                "type": "string"
              },
              "with": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": [
              "uses"
            ]
          }
        }
      },
      "required": [
        "dev",
        "port"
      ]
    },
    "workspace": {
      "type": "object",
      "properties": {
        "preserveBase": {
          "type": "boolean"
        },
        "nativeVerify": {
          "type": "string"
        },
        "nativeBase": {
          "type": "object",
          "properties": {
            "command": {
              "type": "string"
            },
            "install": {
              "type": "string"
            }
          },
          "required": [
            "command"
          ]
        },
        "preserveWhen": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "migrations": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
