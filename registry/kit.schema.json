          "enum": [
            "simple",
            "turbo",
            "nx"
          ]
        },
        "services": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "existing": {
                "type": "boolean"
              },
              "path": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]+(?:\\/[a-zA-Z0-9_-]+)*$"
              },
              "default": {
                "type": "string"
              },
              "variants": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+$"
                },
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+@\\d+\\.\\d+\\.\\d+$"
                }
              }
            },
            "required": [
              "label",
              "path",
              "default",
              "variants"
            ]
          }
        }
      },
      "required": [
        "services"
      ]
