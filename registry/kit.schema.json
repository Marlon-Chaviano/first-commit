    "dependencies": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "devDependencies": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skills": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[\\w.-]+\\/[\\w.-]+@[\\w.:-]+$"
      }
    },
    "mcp": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "command": {
                "type": "string"
              },
              "args": {
                "default": [],
                "type": "array",
                "items": {
