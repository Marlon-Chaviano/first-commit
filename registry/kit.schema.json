              ]
            }
          ]
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "components": {
          "type": "string"
        },
        "addons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "animation": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "styling": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "data": {
          "type": "string"
        },
        "forms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "auth": {
          "type": "string"
        },
        "database": {
          "type": "string"
        },
        "payments": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "i18n": {
          "type": "string"
        },
        "ai": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "observability": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "testing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "quality": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ci": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deploy": {
          "type": "string"
        },
        "design": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "security": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "workflow": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
