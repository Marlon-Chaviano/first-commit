{
  "name": "kits-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build",
    "dev:web": "pnpm --filter web dev",
    "registry:index": "tsx scripts/build-registry.ts",
    "registry:check": "tsx scripts/build-registry.ts --check-skills",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "registry:tag": "tsx scripts/tag-registry.ts"
  },
  "devDependencies": {
    "@kits/schema": "workspace:*",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
}
